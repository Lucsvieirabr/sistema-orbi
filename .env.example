# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Example:
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ============================================================================
# Edge Functions (definir via `supabase secrets set`, NUNCA no bundle do front)
# ============================================================================
# ASAAS_API_KEY=            # access_token da conta Asaas
# ASAAS_SANDBOX=true        # true -> api-sandbox.asaas.com
# ASAAS_WEBHOOK_TOKEN=      # OBRIGATÓRIO: sem ele o webhook rejeita tudo (fail-closed)
# ASAAS_GRACE_DAYS=3        # dias de carência após vencimento antes do bloqueio
