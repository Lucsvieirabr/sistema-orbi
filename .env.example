# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Example:
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_anon_key_here

# SEO (canonical, og:url, og:image, sitemap.xml, robots.txt, llms.txt) — sem barra final.
# No build da Vercel/Netlify o domínio de produção da plataforma tem prioridade
# (VERCEL_PROJECT_PRODUCTION_URL / URL); esta variável vale para os demais builds.
VITE_SITE_URL=https://app.meuorbi.com
# Verificação do Google Search Console / Bing Webmaster (opcional, só o valor do content).
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=

# Cloudflare Turnstile (captcha de login, cadastro e recuperação de senha).
# SITE key é PÚBLICA (vai para o bundle). Deixe vazia para desligar o widget.
# Dev local: use a chave de teste 1x00000000000000000000AA só se o captcha do
# Supabase apontado pelo .env estiver DESLIGADO; com captcha ligado use a site
# key real e inclua localhost nos hostnames do widget.
# O SECRET key NUNCA vai aqui nem em qualquer VITE_*: ele fica somente no painel
# do Supabase (Authentication → Attack Protection → Captcha). O build falha se
# esta variável tiver formato de secret.
VITE_TURNSTILE_SITE_KEY=

# ============================================================================
# Edge Functions (definir via `supabase secrets set`, NUNCA no bundle do front)
# ============================================================================
# ASAAS_API_KEY=            # access_token da conta Asaas
# ASAAS_SANDBOX=true        # true -> api-sandbox.asaas.com
# ASAAS_WEBHOOK_TOKEN=      # OBRIGATÓRIO: sem ele o webhook rejeita tudo (fail-closed)
# ASAAS_GRACE_DAYS=3        # dias de carência após vencimento antes do bloqueio
# ALLOWED_ORIGINS=          # allowlist de CORS/origem, separada por virgula.
#                           # Ex.: https://app.meuorbi.com
#                           # Vazia => somente localhost de desenvolvimento.
# DOCUMENT_EXTRACTOR_URL=   # URL do servico services/document-extractor (sem barra final)
# DOCUMENT_EXTRACTOR_TOKEN= # segredo compartilhado; sem os dois, extract-pdf-text devolve 503

# ============================================================================
# services/document-extractor (container Python, NUNCA exposto ao browser)
# ============================================================================
# EXTRACTOR_SERVICE_TOKEN=  # OBRIGATORIO, >= 32 caracteres, igual a DOCUMENT_EXTRACTOR_TOKEN
# EXTRACTOR_MAX_BYTES=15728640
# EXTRACTOR_OCR_LANGUAGES=por+eng
# Demais variaveis (paginas, DPI, timeouts) em services/document-extractor/README.md

# ----------------------------------------------------------------------------
# REMOVIDAS (integracao logo.dev desligada em 2026-09-10)
# ----------------------------------------------------------------------------
# LOGO_DEV_TOKEN e LOGO_DEV_TOKEN_IMAGES nao sao mais lidas por funcao nenhuma.
# Revogar as duas no painel do logo.dev e remover do projeto:
#   supabase secrets unset LOGO_DEV_TOKEN LOGO_DEV_TOKEN_IMAGES
